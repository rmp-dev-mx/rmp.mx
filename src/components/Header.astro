---
import LogoMarca from "@components/LogoMarca.astro";
import { getLang, useTranslations, localizedUrl, getLogicalPath } from "../i18n/utils";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const navLinks = [
  { href: "/", key: "nav.inicio" },
  { href: "/nosotros", key: "nav.nosotros" },
  { href: "/servicios", key: "nav.servicios" },
  { href: "/boletin", key: "nav.boletin" },
  { href: "/talento", key: "nav.talento" },
  { href: "/contacto", key: "nav.contacto" },
] as const;

const rutaLogica = getLogicalPath(Astro.url.pathname);

function isActive(href: string): boolean {
  if (href === "/") return rutaLogica === "/";
  return rutaLogica === href || rutaLogica.startsWith(`${href}/`);
}
---

<header class="site-header" id="site-header">
  <div class="header-inner">

    <a href={localizedUrl("/", lang)} class="logo" aria-label="Ramírez Medellín, S.C.">
      <LogoMarca class="logo-svg" />
      <span class="logo-texto">
        <span class="logo-firma">Ramírez Medellín</span>
        <span class="logo-sc">S.C.</span>
      </span>
    </a>

    <nav aria-label={lang === "en" ? "Main navigation" : "Navegación principal"}>
      <ul class="nav-menu" id="nav-menu" role="list">
        {navLinks.map(({ href, key }) => (
          <li>
            <a
              href={localizedUrl(href, lang)}
              class:list={["nav-link", { "nav-link--activo": isActive(href) }]}
              aria-current={isActive(href) ? "page" : undefined}
            >
              {t(key)}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="lang-switch" role="group" aria-label={t("lang.aria")}>
      <a
        href={localizedUrl(rutaLogica, "es")}
        class:list={["lang-opt", { "lang-opt--activo": lang === "es" }]}
        hreflang="es"
        aria-current={lang === "es" ? "true" : undefined}
      >ES</a>
      <span class="lang-sep" aria-hidden="true">/</span>
      <a
        href={localizedUrl(rutaLogica, "en")}
        class:list={["lang-opt", { "lang-opt--activo": lang === "en" }]}
        hreflang="en"
        aria-current={lang === "en" ? "true" : undefined}
      >EN</a>
    </div>

    <button
      class="nav-toggle"
      id="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-menu"
      aria-label={lang === "en" ? "Open navigation menu" : "Abrir menú de navegación"}
    >
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
    </button>

  </div>
</header>

<style>
  /* ── Variables de estado del header ── */
  .site-header {
    --h-bg: var(--rm-papel);
    --h-color: var(--rm-tinta);
    --h-border: transparent;
    --h-acento: var(--rm-ambar);
    --h-tenue: var(--rm-tinta-2);
    --foco: var(--rm-ambar);
  }
  .site-header.scrolled {
    --h-bg: var(--rm-papel);
    --h-border: var(--rm-linea);
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--h-bg);
    color: var(--h-color);
    border-bottom: 1px solid var(--h-border);
    transition: background 0.35s ease, color 0.35s ease, border-color 0.35s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header { transition: none; }
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: calc(var(--espacio) * 3);
    max-width: var(--ancho-max);
    margin: 0 auto;
    padding: 0 calc(var(--espacio) * 3);
    height: 64px;
  }

  /* ── Logo ── */
  .logo {
    display: flex;
    align-items: center;
    gap: calc(var(--espacio) * 1.5);
    text-decoration: none;
    color: inherit;
    flex-shrink: 0;
  }

  .logo-svg {
    height: 38px;
    flex-shrink: 0;
  }

  .logo-texto {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .logo-firma {
    font-family: var(--rm-display);
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .logo-sc {
    font-family: var(--rm-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.18em;
    color: var(--h-acento);
    text-transform: uppercase;
  }

  /* ── Nav ── */
  nav { flex: 1; }

  .nav-menu {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 2px;
    list-style: none;
  }

  .nav-link {
    display: block;
    padding: 6px calc(var(--espacio) * 1.25);
    font-family: var(--rm-mono);
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: inherit;
    border-radius: var(--radio);
    transition: color 0.15s ease;
  }

  .nav-link:hover { color: var(--h-acento); }

  .nav-link--activo {
    color: var(--h-acento);
    font-weight: 700;
    box-shadow: inset 0 -2px 0 currentColor;
  }

  /* ── Selector de idioma ── */
  .lang-switch {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
    font-family: var(--rm-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  .lang-opt {
    color: var(--h-tenue);
    font-weight: 500;
    text-decoration: none;
    padding: 4px 5px;
    border-radius: var(--radio);
    transition: color 0.15s ease;
  }
  .lang-opt:hover { color: var(--h-acento); }
  .lang-opt--activo { color: var(--h-acento); font-weight: 700; }
  .lang-opt:focus-visible { outline: 2px solid var(--h-acento); outline-offset: 2px; }

  .lang-sep {
    color: var(--h-tenue);
  }

  /* ── Hamburguesa ── */
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    padding: 10px;
    min-width: 44px;
    min-height: 44px;
    background: none;
    border: none;
    cursor: pointer;
    color: inherit;
    border-radius: var(--radio);
    flex-shrink: 0;
  }

  .hamburger-bar {
    display: block;
    width: 22px;
    height: 2px;
    background: currentColor;
    border-radius: 1px;
    transition: transform 0.25s ease, opacity 0.2s ease;
    transform-origin: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .hamburger-bar { transition: none; }
  }

  .nav-toggle[aria-expanded="true"] .hamburger-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav-toggle[aria-expanded="true"] .hamburger-bar:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  .nav-toggle[aria-expanded="true"] .hamburger-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ── Tablet ── */
  @media (min-width: 768px) and (max-width: 1023px) {
    .header-inner { gap: calc(var(--espacio) * 2); }
    .logo-texto { display: none; }
    .nav-link { font-size: 15px; padding: 6px calc(var(--espacio) * 0.75); }
  }

  /* ── Móvil ── */
  @media (max-width: 767px) {
    .header-inner {
      height: 56px;
      padding: 0 calc(var(--espacio) * 2);
      position: relative;
    }

    nav {
      position: absolute;
      top: 56px;
      left: 0;
      right: 0;
      background: var(--h-bg);
      border-bottom: 1px solid var(--h-border);
      transition: background 0.35s ease, border-color 0.35s ease;
    }

    @media (prefers-reduced-motion: reduce) {
      nav { transition: none; }
    }

    .nav-menu {
      display: none;
      flex-direction: column;
      align-items: stretch;
      padding: var(--espacio) calc(var(--espacio) * 2) calc(var(--espacio) * 2);
      gap: 2px;
    }

    .nav-menu.nav-menu--open { display: flex; }

    .nav-link { font-size: 13.5px; padding: 12px calc(var(--espacio) * 1.5); }

    /* Cinzel es más ancho que la sans anterior: el logotipo cede espacio
       para que el botón de menú no se salga de la pantalla en 360px */
    .logo { min-width: 0; }
    .logo-svg { height: 30px; }
    .logo-texto { min-width: 0; overflow: hidden; }
    .logo-firma { font-size: 13px; white-space: nowrap; }
    .logo-sc { display: none; }
  }

  /* Por debajo de 400px sólo cabe la marca; el nombre lo lleva el H1 */
  @media (max-width: 400px) {
    .logo-texto { display: none; }

    .lang-switch { margin-left: auto; }
    .nav-toggle { display: flex; margin-left: var(--espacio); }
  }
</style>

<script>
  const header = document.getElementById("site-header");
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("nav-menu");

  function actualizarHeader() {
    header?.classList.toggle("scrolled", window.scrollY > 60);
  }
  window.addEventListener("scroll", actualizarHeader, { passive: true });
  actualizarHeader();

  toggle?.addEventListener("click", () => {
    const abierto = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!abierto));
    menu?.classList.toggle("nav-menu--open", !abierto);
  });
</script>
