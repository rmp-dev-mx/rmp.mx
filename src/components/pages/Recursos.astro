---
import Base from "@layouts/Base.astro";
import Cabecera from "@components/Cabecera.astro";
import { getLang } from "../../i18n/utils";
import { getRecursos } from "../../i18n/recursos";

const lang = getLang(Astro.currentLocale);
const r = getRecursos(lang);

const SALIDA =
  '<path d="M14 5h5v5"/><path d="M19 5 10.5 13.5"/><path d="M18 13.5V19H5V6h5.5"/>';
---

<Base title={r.metaTitle} description={r.metaDesc} translated={true} fuentes="nuevo">
  <div class="mundo">

    <Cabecera titulo={r.heroH1} sub={r.heroSub} />

    <section class="directorio" aria-label={r.directorioAria}>
      <div class="marco">
        <ul class="rejilla" role="list">
          {r.lista.map((s) => (
            <li class="sitio">
              <a class="sitio-enlace" href={s.url} target="_blank" rel="noopener noreferrer">
                <span class="sitio-nombre">{s.nombre}</span>
                <svg class="ico sitio-ico" viewBox="0 0 24 24" aria-hidden="true" set:html={SALIDA} />
              </a>
              <p class="sitio-desc">{s.desc}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

  </div>
</Base>

<style>
  .directorio { padding-block: clamp(44px, 6vw, 88px); }

  .rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--rm-tinta);
  }

  .sitio {
    padding: 22px clamp(14px, 1.6vw, 24px) 22px 0;
    border-bottom: 1px solid var(--rm-linea);
  }

  .sitio-enlace {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--rm-tinta);
    text-decoration: none;
  }

  .sitio-nombre {
    font-family: var(--rm-display);
    font-weight: 500;
    font-size: clamp(19px, 1.5vw, 23px);
    letter-spacing: -0.01em;
    text-transform: uppercase;
    transition: color 0.3s ease;
  }

  .sitio-ico {
    color: var(--rm-ambar);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .sitio-enlace:hover .sitio-nombre { color: var(--rm-ambar); }
  .sitio-enlace:hover .sitio-ico { transform: translate(2px, -2px); }

  .sitio-desc {
    margin: 6px 0 0;
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--rm-tinta-2);
    max-width: 34ch;
  }
</style>
