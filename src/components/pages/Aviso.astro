---
import Base from "@layouts/Base.astro";
import { getLang } from "../../i18n/utils";
import { getAviso } from "../../i18n/aviso";

const lang = getLang(Astro.currentLocale);
const a = getAviso(lang);
---

<Base title={a.metaTitle} description={a.metaDesc} translated={true}>

  <!-- ═══════════════════════════════ HERO ═══ -->
  <section class="phero fondo-oscuro">
    <div class="phero-lineas" aria-hidden="true"></div>
    <div class="contenedor phero-inner">
      <p class="eyebrow phero-anim-1">
        <span class="eyebrow-linea" aria-hidden="true"></span>
        {a.heroEyebrow}
      </p>
      <h1 class="phero-h1 phero-anim-2">
        {a.heroH1[0]}<br />
        <em class="texto-oro">{a.heroH1[1]}</em>
      </h1>
      <p class="phero-sub phero-anim-3">{a.heroSub}</p>
    </div>
  </section>

  <!-- ═══════════════════════════════ CUERPO ═══ -->
  <section class="aviso" aria-label={a.seccionesAria}>
    <div class="contenedor aviso-inner">

      <p class="aviso-vigencia">
        <span class="aviso-vigencia-etq">{a.vigenciaEtiqueta}</span>
        <span class="aviso-vigencia-fecha">{a.vigenciaFecha}</span>
      </p>

      <ol class="aviso-lista" role="list">
        {a.secciones.map((s, i) => (
          <li class="aviso-seccion revela" style={`--retraso: ${(i % 3) * 50}ms`}>
            <h2 class="aviso-titulo">
              <span class="aviso-folio" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              {s.titulo}
            </h2>
            {s.parrafos?.map((p) => <p class="aviso-parrafo">{p}</p>)}
            {s.lista && (
              <ul class="aviso-puntos" role="list">
                {s.lista.map((punto) => <li>{punto}</li>)}
              </ul>
            )}
          </li>
        ))}
      </ol>

    </div>
  </section>

</Base>

<style>
  .contenedor {
    max-width: var(--ancho-max);
    margin: 0 auto;
    padding-inline: calc(var(--espacio) * 3);
  }

  .eyebrow {
    font-family: var(--fuente-datos);
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--oro);
    margin-bottom: calc(var(--espacio) * 2.5);
  }

  .eyebrow-linea {
    display: inline-block;
    width: 48px;
    height: 1px;
    background: var(--oro);
    vertical-align: middle;
    margin-inline-end: calc(var(--espacio) * 1.5);
  }

  .texto-oro { color: var(--oro); font-style: italic; }

  /* ═══════ HERO ═══════ */
  .phero {
    position: relative;
    background-color: var(--tinta);
    background-image: radial-gradient(
      ellipse 90% 70% at 30% 10%,
      rgb(26 53 101 / 0.5),
      transparent 60%
    );
    overflow: hidden;
  }

  .phero-lineas {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent 47px,
      rgb(216 210 196 / 0.07) 47px,
      rgb(216 210 196 / 0.07) 48px
    );
    mask-image: linear-gradient(to bottom, transparent, black 20%);
  }

  .phero-inner {
    position: relative;
    z-index: 1;
    padding-block: calc(64px + var(--espacio) * 10) calc(var(--espacio) * 10);
  }

  .phero-h1 {
    font-family: var(--fuente-display);
    font-weight: 500;
    font-size: clamp(44px, 6.5vw, 92px);
    line-height: 1.0;
    letter-spacing: -0.025em;
    color: var(--papel);
    margin: 0 0 calc(var(--espacio) * 3);
  }

  .phero-sub {
    font-size: clamp(16px, 1.6vw, 18px);
    line-height: 1.7;
    color: rgb(250 247 240 / 0.6);
    max-width: 560px;
  }

  .phero-anim-1 { animation: sube 0.5s ease 0.1s both; }
  .phero-anim-2 { animation: sube 0.6s ease 0.25s both; }
  .phero-anim-3 { animation: sube 0.5s ease 0.4s both; }

  @keyframes sube {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ═══════ CUERPO DEL AVISO ═══════ */
  .aviso { padding-block: calc(var(--espacio) * 10) calc(var(--espacio) * 14); }

  .aviso-inner { max-width: 760px; }

  .aviso-vigencia {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-bottom: calc(var(--espacio) * 3);
    margin-bottom: calc(var(--espacio) * 5);
    border-bottom: 1px solid var(--regla);
  }

  .aviso-vigencia-etq {
    font-family: var(--fuente-datos);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--oro);
  }

  .aviso-vigencia-fecha {
    font-family: var(--fuente-datos);
    font-size: 14px;
    color: var(--pizarra);
    font-variant-numeric: tabular-nums;
  }

  .aviso-lista {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: calc(var(--espacio) * 6);
  }

  .aviso-titulo {
    font-family: var(--fuente-display);
    font-weight: 600;
    font-size: clamp(20px, 2.4vw, 26px);
    line-height: 1.2;
    color: var(--tinta);
    margin-bottom: calc(var(--espacio) * 2);
    display: flex;
    align-items: baseline;
    gap: calc(var(--espacio) * 1.5);
  }

  .aviso-folio {
    font-family: var(--fuente-datos);
    font-size: 13px;
    font-weight: 500;
    color: var(--oro);
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
  }

  .aviso-parrafo {
    font-size: clamp(15px, 1.5vw, 16px);
    line-height: 1.75;
    color: var(--pizarra);
    max-width: 66ch;
  }

  .aviso-parrafo + .aviso-parrafo { margin-top: calc(var(--espacio) * 2); }

  .aviso-puntos {
    list-style: none;
    margin-top: calc(var(--espacio) * 2);
    display: flex;
    flex-direction: column;
    gap: calc(var(--espacio) * 1.5);
    max-width: 66ch;
  }

  .aviso-puntos li {
    position: relative;
    padding-left: calc(var(--espacio) * 3);
    font-size: clamp(15px, 1.5vw, 16px);
    line-height: 1.7;
    color: var(--pizarra);
  }

  .aviso-puntos li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 8px;
    height: 1px;
    background: var(--oro);
  }

  /* ═══════ Responsive ═══════ */
  @media (max-width: 767px) {
    .contenedor { padding-inline: calc(var(--espacio) * 2); }
    .aviso-titulo { flex-direction: column; gap: calc(var(--espacio) * 0.75); }
  }
</style>

<script>
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const revelables = document.querySelectorAll(".revela");
  if (reduceMotion) {
    revelables.forEach((el) => el.classList.add("visible"));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("visible");
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.1, rootMargin: "0px 0px -30px 0px" }
    );
    revelables.forEach((el) => io.observe(el));
  }
</script>
