---
import Base from "@layouts/Base.astro";
import AsistenteContacto from "@components/AsistenteContacto.astro";
import Cabecera from "@components/Cabecera.astro";
import { getLang } from "../../i18n/utils";
import { getContacto } from "../../i18n/contacto";
import { getHome } from "../../i18n/home";

const lang = getLang(Astro.currentLocale);
const c = getContacto(lang);

// Domicilio, teléfonos y correo de la oficina viven en el diccionario de la
// portada: se toman de ahí para no tener dos versiones del mismo dato.
const { contactoDomicilio: domicilio, contactoTelefonos: telefonos, contactoCorreo: correo } =
  getHome(lang);

const mapaSrc =
  "https://www.google.com/maps?q=Calle+Francisco+Pe%C3%B1a+245,+Las+%C3%81guilas+3ra+Secci%C3%B3n,+San+Luis+Potos%C3%AD,+S.L.P.&output=embed";
---

<Base title={c.metaTitle} description={c.metaDesc} translated={true} fuentes="nuevo">
  <div class="mundo">

    <Cabecera
      titulo={c.heroH1}
      sub={c.heroSub}
      foto="/images/fotos/contacto-oficina.webp"
      alt=""
      foco="40%"
    />

    <!-- ═════════════════════════════════ ASISTENTE + DATOS ══ -->
    <section class="cuerpo" aria-label={c.seccionAria}>
      <div class="marco cuerpo-grid">

        <div class="columna-asistente">
          <AsistenteContacto asistente={c.asistente} />
          <p class="respaldo">
            {c.respaldoPre}<a href={`mailto:${correo}`}>{correo}</a>{c.respaldoPost}
          </p>
        </div>

        <aside class="columna-datos">
          <div class="ficha">
            <h2 class="dato ficha-titulo">{c.datoOficina}</h2>
            <address class="ficha-texto">
              {domicilio.map((linea, i) => <>{i > 0 && <br />}{linea}</>)}
            </address>
          </div>

          <div class="ficha">
            <h2 class="dato ficha-titulo">{c.datoTelefonos}</h2>
            <ul class="ficha-lista" role="list">
              {telefonos.map(({ texto, tel }) => (
                <li><a class="ficha-enlace" href={`tel:${tel}`}>{texto}</a></li>
              ))}
            </ul>
          </div>

          <div class="ficha">
            <h2 class="dato ficha-titulo">{c.datoCorreo}</h2>
            <a class="ficha-enlace" href={`mailto:${correo}`}>{correo}</a>
            <p class="ficha-sub">{c.datoCorreoSub}</p>
            <ul class="ficha-lista ficha-lista--areas" role="list">
              {c.correosArea.map(({ area, correo }) => (
                <li>
                  <span class="dato ficha-area">{area}</span>
                  <a class="ficha-enlace" href={`mailto:${correo}`}>{correo}</a>
                </li>
              ))}
            </ul>
          </div>

          <div class="ficha">
            <h2 class="dato ficha-titulo">{c.datoHorario}</h2>
            <p class="ficha-horario">{c.datoHorarioValor}</p>
          </div>
        </aside>

      </div>
    </section>

    <!-- ════════════════════════════════════════════════ MAPA ══ -->
    <section class="mapa" aria-label={c.mapaAria}>
      <iframe
        src={mapaSrc}
        title={c.mapaTitle}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      ></iframe>
    </section>

  </div>
</Base>

<style>
  /* ══════════════════════════ ASISTENTE + DATOS ══════════════════════════ */
  .cuerpo { padding-block: clamp(44px, 6vw, 88px); }

  .cuerpo-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    gap: clamp(28px, 4vw, 64px);
    align-items: start;
  }

  .respaldo {
    margin-top: 20px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--rm-tinta-2);
  }

  .respaldo a {
    color: var(--rm-acento);
    text-underline-offset: 4px;
  }

  .columna-datos {
    display: grid;
    gap: clamp(22px, 2.6vw, 34px);
  }

  .ficha-titulo {
    margin: 0 0 10px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--rm-linea);
    font-size: 11.5px;
  }

  .ficha-texto {
    font-style: normal;
    font-size: 16px;
    line-height: 1.55;
  }

  .ficha-lista {
    display: grid;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ficha-lista--areas {
    gap: 10px;
    margin-top: 12px;
  }

  .ficha-area {
    display: block;
    font-size: 10.5px;
    margin-bottom: 1px;
  }

  .ficha-enlace {
    font-size: 15.5px;
    color: var(--rm-azul);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }

  .ficha-enlace:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .ficha-sub {
    margin-top: 14px;
    font-size: 14px;
    color: var(--rm-tinta-2);
  }

  .ficha-horario {
    margin: 0;
    font-size: 15.5px;
    font-variant-numeric: tabular-nums;
  }

  /* ════════════════════════════════ MAPA ════════════════════════════════ */
  .mapa {
    border-top: 1px solid var(--rm-linea);
    line-height: 0;
  }

  .mapa iframe {
    width: 100%;
    height: clamp(300px, 42vh, 460px);
    border: 0;
    filter: saturate(0.72) contrast(1.02);
  }

  /* ══════════════════════════════ Adaptación ══════════════════════════════ */
  @media (max-width: 900px) {
    .cuerpo-grid { grid-template-columns: 1fr; }
  }
</style>
