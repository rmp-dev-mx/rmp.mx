---
import Base from "@layouts/Base.astro";
import Cabecera from "@components/Cabecera.astro";
import { getLang, localizedUrl } from "../../i18n/utils";
import { getTalento } from "../../i18n/talento";

const lang = getLang(Astro.currentLocale);
const t = getTalento(lang);
const f = t.f;
const avisoHref = localizedUrl("/aviso-de-privacidad", lang);

// Un campo del formulario. `err` marca el campo como obligatorio y da el
// texto de error; `corto` lo hace la columna angosta de su fila.
interface Campo {
  name: string;
  label: string;
  tipo?: "text" | "email" | "tel" | "number" | "textarea";
  err?: string;
  auto?: string;
  ph?: string;
  corto?: boolean;
  min?: string;
  max?: string;
  inputmode?: "numeric";
}

// Una fila es un campo solo o un par lado a lado (.campo-fila).
type Fila = Campo | Campo[];

const nombre: Campo = { name: "nombre", label: f.nombre, err: f.errNombre, auto: "given-name" };
const apellidos: Campo = { name: "apellidos", label: f.apellidos, err: f.errApellidos, auto: "family-name" };
const email: Campo = { name: "email", label: f.email, tipo: "email", err: f.errEmail, auto: "email" };
const telefono: Campo = { name: "telefono", label: f.telefono, tipo: "tel", err: f.errTelefono, auto: "tel" };
const domicilio: Campo = { name: "domicilio", label: f.domicilio, auto: "street-address" };
const universidad: Campo = { name: "universidad", label: f.universidad };
const idioma: Campo = { name: "idioma", label: f.idioma, ph: f.phIdioma };
const experiencia: Campo = { name: "experiencia", label: f.experiencia, tipo: "textarea" };
const interes: Campo = { name: "interes", label: f.interes, tipo: "textarea" };

const vias: { id: string; prefijo: string; tab: string; intro: string; filas: Fila[] }[] = [
  {
    id: "practicantes",
    prefijo: "p",
    tab: t.tabPracticantes,
    intro: t.introPracticantes,
    filas: [
      [nombre, apellidos],
      [email, { name: "edad", label: f.edad, tipo: "number", corto: true, min: "16", max: "99", inputmode: "numeric" }],
      domicilio,
      [telefono, { ...universidad, err: f.errUniversidad }],
      [{ name: "carrera", label: f.carrera, err: f.errCarrera }, { name: "semestre", label: f.semestre, corto: true }],
      idioma,
      experiencia,
      interes,
    ],
  },
  {
    id: "bolsa",
    prefijo: "b",
    tab: t.tabBolsa,
    intro: t.introBolsa,
    filas: [
      [nombre, apellidos],
      [email, telefono],
      domicilio,
      [{ name: "profesion", label: f.profesion, err: f.errProfesion, ph: f.phProfesion }, universidad],
      idioma,
      experiencia,
      interes,
    ],
  },
];
---

<Base title={t.metaTitle} description={t.metaDesc} translated={true} fuentes="nuevo">
  <div class="mundo">

    <Cabecera
      titulo={t.heroH1}
      sub={t.heroSub}
      foto="/images/fotos/talento-equipo.webp"
      alt=""
      foco="38%"
    />

    <section class="vias" aria-label={t.viasAria}>
      <div class="marco">

        <div class="tabs" role="tablist" aria-label={t.tablistAria}>
          {vias.map((v, i) => (
            <button
              class:list={["tab", { "tab--activa": i === 0 }]}
              id={`tab-${v.id}`}
              role="tab"
              aria-selected={String(i === 0)}
              aria-controls={`panel-${v.id}`}
              type="button"
            >
              {v.tab}
            </button>
          ))}
        </div>

        {vias.map((v, i) => (
          <div
            class="panel"
            id={`panel-${v.id}`}
            role="tabpanel"
            aria-labelledby={`tab-${v.id}`}
            tabindex="0"
            hidden={i > 0}
          >
            <p class="panel-intro">{v.intro}</p>

            <form class="form" data-form-talento data-asunto={f.asunto} data-tipo={v.tab} action={`mailto:${t.correo}`} novalidate>
              {v.filas.map((fila) => {
                const campos = (Array.isArray(fila) ? fila : [fila]).map((c) => {
                  const id = `${v.prefijo}-${c.name}`;
                  return (
                    <div class:list={["campo", { "campo--corto": c.corto }]}>
                      <label for={id}>{c.label}{c.err && " "}{c.err && <span class="req" aria-hidden="true">*</span>}</label>
                      {c.tipo === "textarea" ? (
                        <textarea id={id} name={c.name} rows="3"></textarea>
                      ) : (
                        <input type={c.tipo ?? "text"} id={id} name={c.name} required={!!c.err} autocomplete={c.auto} placeholder={c.ph} min={c.min} max={c.max} inputmode={c.inputmode} />
                      )}
                      {c.err && <p class="campo-error" hidden>{c.err}</p>}
                    </div>
                  );
                });
                return Array.isArray(fila) ? <div class="campo-fila">{campos}</div> : campos;
              })}

              <p class="form-nota">{f.cvNota}</p>

              <button type="submit" class="form-enviar">{f.enviar}</button>
              <p class="form-exito" hidden>
                {f.exitoPre}<a href={`mailto:${t.correo}`}>{t.correo}</a>{f.exitoPost}
              </p>
              <p class="form-aviso">
                {f.avisoPre}<a href={avisoHref}>{f.avisoLink}</a>{f.avisoPost}
              </p>
            </form>
          </div>
        ))}

      </div>
    </section>

  </div>
</Base>

<style>
  /* ═══════ TABS ═══════ */
  .vias { padding-block: calc(var(--espacio) * 10) calc(var(--espacio) * 14); }

  .tabs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-bottom: 1px solid var(--rm-acento);
    position: relative;
    margin-bottom: calc(var(--espacio) * 6);
  }

  .tabs::after {
    content: "";
    position: absolute;
    inset: auto 0 -4px 0;
    border-bottom: 1px solid var(--rm-acento);
  }

  .tab {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: calc(var(--espacio) * 1.5);
    padding: calc(var(--espacio) * 2.5);
    font-family: var(--rm-serif);
    font-weight: 500;
    font-size: clamp(18px, 2.4vw, 24px);
    color: var(--rm-tinta-2);
    background: none;
    border: none;
    border-bottom: 3px solid transparent;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease;
    min-height: 44px;
  }

  .tab:hover { color: var(--rm-tinta); }

  .tab--activa {
    color: var(--rm-tinta);
    border-bottom-color: var(--rm-acento);
  }

  @media (prefers-reduced-motion: reduce) {
    .tab { transition: none; }
  }

  /* ═══════ PANELES Y FORMULARIO ═══════ */
  .panel-intro {
    font-size: 16px;
    line-height: 1.7;
    color: var(--rm-tinta-2);
    margin-bottom: calc(var(--espacio) * 5);
    max-width: 560px;
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: calc(var(--espacio) * 3);
  }

  .campo {
    display: flex;
    flex-direction: column;
    gap: calc(var(--espacio) * 0.75);
    flex: 1;
  }

  .campo-fila {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: calc(var(--espacio) * 3);
  }

  .campo-fila:has(.campo--corto) {
    grid-template-columns: 1fr minmax(120px, 0.4fr);
  }

  .campo label {
    font-family: var(--rm-serif);
    font-size: 14px;
    font-weight: 500;
    color: var(--rm-tinta);
  }

  .req { color: var(--rm-acento); }

  .campo input,
  .campo textarea {
    font-family: var(--rm-serif);
    font-size: 16px;
    color: var(--rm-tinta);
    background: var(--rm-papel);
    border: 1px solid var(--rm-linea);
    border-radius: 0;
    padding: calc(var(--espacio) * 1.5) calc(var(--espacio) * 2);
    width: 100%;
    transition: border-color 0.15s ease;
  }

  .campo textarea { resize: vertical; }

  .campo input:hover,
  .campo textarea:hover { border-color: var(--rm-tinta-2); }

  .campo input:focus-visible,
  .campo textarea:focus-visible {
    outline: 2px solid var(--rm-acento);
    outline-offset: 0;
    border-color: var(--rm-acento);
  }

  .campo input.invalido,
  .campo textarea.invalido { border-color: var(--error); }

  .campo-error {
    font-size: 13px;
    color: var(--error);
    margin: 0;
  }

  .form-enviar {
    align-self: flex-start;
    font-family: var(--rm-serif);
    font-size: 15px;
    font-weight: 700;
    color: var(--rm-papel);
    background: var(--rm-acento);
    border: 1px solid var(--rm-acento);
    border-radius: 0;
    padding: calc(var(--espacio) * 1.5) calc(var(--espacio) * 4);
    min-height: 44px;
    cursor: pointer;
    transition: filter 0.15s ease;
  }

  .form-enviar:hover { filter: brightness(0.9); }

  .form-exito {
    font-size: 15px;
    font-weight: 500;
    color: var(--exito);
    background: color-mix(in srgb, var(--exito) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--exito) 25%, transparent);
    border-radius: 0;
    padding: calc(var(--espacio) * 2);
    margin: 0;
  }

  .form-aviso {
    font-size: 13px;
    color: var(--rm-tinta-2);
    margin: 0;
  }

  .form-aviso a,
  .form-exito a { color: inherit; }

  .form-nota {
    font-size: 14px;
    color: var(--rm-tinta-2);
    margin: 0;
  }

  /* ═══════ Responsive ═══════ */
  @media (max-width: 767px) {
    .campo-fila,
    .campo-fila:has(.campo--corto) { grid-template-columns: 1fr; }

    .tab {
      flex-direction: column;
      gap: 4px;
      font-size: 16px;
      padding: calc(var(--espacio) * 2) var(--espacio);
    }
  }
</style>

<script>
  /* ── Tabs accesibles ── */
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[role='tab']"));

  function activar(tab: HTMLButtonElement) {
    for (const t of tabs) {
      const seleccionada = t === tab;
      t.setAttribute("aria-selected", String(seleccionada));
      t.classList.toggle("tab--activa", seleccionada);
      const panel = document.getElementById(t.getAttribute("aria-controls") ?? "");
      if (panel) panel.hidden = !seleccionada;
    }
    tab.focus();
  }

  tabs.forEach((tab, i) => {
    tab.addEventListener("click", () => activar(tab));
    tab.addEventListener("keydown", (e) => {
      const delta = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
      if (delta) {
        e.preventDefault();
        activar(tabs[(i + delta + tabs.length) % tabs.length]!);
      }
    });
  });

  /* ── Envío de formularios ──
     Sin servidor: al validar se abre el programa de correo del candidato con
     la postulación prellenada (mailto:), igual que el asistente de /contacto.
     El CV no puede adjuntarse por mailto; el candidato lo adjunta a mano. */
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  for (const form of document.querySelectorAll<HTMLFormElement>("[data-form-talento]")) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();

      let valido = true;
      for (const campo of form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
        "input[required], textarea[required]"
      )) {
        const error = campo.parentElement?.querySelector<HTMLElement>(".campo-error");
        const esInvalido =
          campo.value.trim() === "" ||
          (campo.type === "email" && !campo.checkValidity());

        campo.classList.toggle("invalido", esInvalido);
        campo.setAttribute("aria-invalid", String(esInvalido));
        if (error) error.hidden = !esInvalido;
        if (esInvalido) valido = false;
      }

      if (!valido) return;

      // Cuerpo: "Etiqueta: valor" de cada campo lleno, en el orden del formulario.
      const lineas: string[] = [];
      for (const campo of form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
        "input, textarea"
      )) {
        const valor = campo.value.trim();
        if (!valor) continue;
        const etiqueta = form
          .querySelector(`label[for="${campo.id}"]`)
          ?.firstChild?.textContent?.trim();
        lineas.push(`${etiqueta ?? campo.name}: ${valor}`);
      }

      const datos = new FormData(form);
      const nombre = `${datos.get("nombre") ?? ""} ${datos.get("apellidos") ?? ""}`.trim();
      const asunto = `${form.dataset.asunto} — ${form.dataset.tipo} — ${nombre}`;
      window.location.href =
        `${form.getAttribute("action")}?subject=${encodeURIComponent(asunto)}` +
        `&body=${encodeURIComponent(lineas.join("\n"))}`;

      const exito = form.querySelector<HTMLElement>(".form-exito");
      if (exito) {
        exito.hidden = false;
        exito.scrollIntoView({ behavior: reduceMotion ? "auto" : "smooth", block: "nearest" });
      }
    });
  }
</script>
