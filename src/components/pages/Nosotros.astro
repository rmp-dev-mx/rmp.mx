---
import Base from "@layouts/Base.astro";
import Cabecera from "@components/Cabecera.astro";
import { url } from "../../lib/url";
import { getLang, localizedUrl } from "../../i18n/utils";
import { getNosotros } from "../../i18n/nosotros";

const lang = getLang(Astro.currentLocale);
const n = getNosotros(lang);

const FLECHA = '<path d="M5 12h13"/><path d="m12.5 6 6 6-6 6"/>';

// Iniciales del socio fundador, para el monograma mientras no haya foto.
const iniciales = n.socioNombre
  .split(" ")
  .filter((p) => p.length > 2)
  .slice(0, 2)
  .map((p) => p[0])
  .join("");
---

<Base title={n.metaTitle} description={n.metaDesc} translated={true} fuentes="nuevo">
  <div class="mundo">

    <Cabecera
      titulo={n.heroH1}
      sub={n.heroSub}
      foto="/images/fotos/nosotros-slp.webp"
      alt={n.slpAlt}
      foco="42%"
    />

    <!-- ═══════════════════════════════════════════ HISTORIA ══ -->
    <section class="historia" aria-labelledby="historia-titulo">
      <div class="marco historia-grid">
        <div>
          <h2 class="titulo-seccion" id="historia-titulo">
            {n.historiaTitulo[0]} {n.historiaTitulo[1]}
          </h2>
          <p class="parrafo">{n.historiaP1}</p>
          <p class="parrafo">
            {n.historiaP2pre}<strong>{n.historiaP2strong}</strong>{n.historiaP2post}
          </p>
        </div>
        <figure class="historia-figura">
          <img
            src={url("/images/fotos/nosotros-historia.webp")}
            alt=""
            width="1856"
            height="2304"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════ PACIOLI ══ -->
    <section class="filial" aria-label={n.filialAlt}>
      <div class="marco filial-grid">
        <img
          class="filial-logo"
          src={url("/images/pacioli.svg")}
          alt={n.filialAlt}
          width="220"
          height="68"
          loading="lazy"
          decoding="async"
        />
        <div>
          <p class="parrafo filial-texto">
            {n.filialDescPre}<strong>{n.filialDescStrong}</strong>{n.filialDescPost}
          </p>
          <!-- TODO: pedir al cliente el alcance y objeto de la filial -->
          <a class="accion accion--ambar" href={localizedUrl("/servicios#asesoria", lang)}>
            <span>{n.filialLink}</span>
            <span class="accion-circulo" aria-hidden="true">
              <svg class="ico" viewBox="0 0 24 24" set:html={FLECHA} />
            </span>
          </a>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════ MISIÓN Y VISIÓN ══ -->
    <section class="mvv" aria-label={n.mvvAria}>
      <div class="marco">
        <div class="mvv-grid">
          <div class="mvv-bloque">
            <h2 class="dato mvv-et">{n.misionTitulo}</h2>
            <p class="mvv-texto">{n.misionTexto}</p>
          </div>
          <div class="mvv-bloque">
            <h2 class="dato mvv-et">{n.visionTitulo}</h2>
            <p class="mvv-texto">{n.visionTexto}</p>
          </div>
          <div class="mvv-bloque">
            <h2 class="dato mvv-et">{n.filosofiaTitulo}</h2>
            <p class="mvv-texto">{n.filosofiaTexto}</p>
          </div>
        </div>

        <ul class="valores" role="list" aria-label={n.valoresAria}>
          {n.valores.map((v) => (
            <li class="valor">
              <p class="valor-nombre">{v.nombre}</p>
              <p class="valor-desc">{v.desc}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ═════════════════════════════════════════════════ CITA ══ -->
    <section class="cita" aria-label={n.citaAria}>
      <div class="marco">
        <blockquote class="cita-texto">{n.citaTexto}</blockquote>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════ SOCIO ══ -->
    <section class="socio" aria-labelledby="socio-titulo">
      <div class="marco socio-grid">
        <p class="monograma" aria-hidden="true">{iniciales}</p>
        <div>
          <p class="dato">{n.socioEyebrow}</p>
          <h2 class="socio-nombre" id="socio-titulo">{n.socioNombre}</h2>
          <p class="parrafo socio-texto">{n.socioTexto}</p>
          <!-- TODO: semblanza y retrato del socio fundador, pendientes del cliente -->
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════ EQUIPO ══ -->
    <section class="equipo" aria-labelledby="equipo-titulo">
      <div class="marco">
        <h2 class="titulo-seccion" id="equipo-titulo">
          {n.equipoTitulo[0]} {n.equipoTitulo[1]}
        </h2>

        <div class="equipo-areas">
          {n.equipo.map((grupo) => (
            <section class="equipo-grupo" aria-label={grupo.area}>
              <h3 class="dato equipo-area">{grupo.area}</h3>
              <ul class="equipo-lista" role="list">
                {grupo.personas.map((p) => {
                  // Foto opcional: se muestra sólo si la persona la trae en i18n.
                  const foto = (p as { foto?: string }).foto;
                  return (
                    <li class:list={["persona", foto && "persona--foto"]}>
                      {foto && (
                        <img
                          class="persona-foto"
                          src={url(foto)}
                          alt=""
                          width="64"
                          height="64"
                          loading="lazy"
                          decoding="async"
                        />
                      )}
                      <div>
                        <p class="persona-nombre">{p.nombre}</p>
                        <p class="persona-credencial">{p.credencial}</p>
                        <a class="persona-correo" href={`mailto:${p.correo}`}>{p.correo}</a>
                      </div>
                    </li>
                  );
                })}
              </ul>
            </section>
          ))}
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════ CIERRE ══ -->
    <section class="cierre">
      <div class="marco cierre-grid">
        <h2 class="titulo-seccion">{n.ctaTitulo[0]} {n.ctaTitulo[1]}</h2>
        <a class="boton" href={localizedUrl("/contacto", lang)}>
          <span>{n.ctaAgenda}</span>
          <span class="accion-circulo" aria-hidden="true">
            <svg class="ico" viewBox="0 0 24 24" set:html={FLECHA} />
          </span>
        </a>
      </div>
    </section>

  </div>
</Base>

<style>
  .parrafo {
    margin-top: 16px;
    font-size: 16px;
    line-height: 1.65;
    color: var(--rm-tinta-2);
    max-width: 52ch;
    text-align: justify;
    hyphens: auto;
  }

  .parrafo strong { color: var(--rm-tinta); font-weight: 600; }

  /* ═══════════════════════════════ HISTORIA ═══════════════════════════════ */
  .historia { padding-block: clamp(44px, 6vw, 88px); }

  .historia-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.7fr);
    gap: clamp(26px, 4vw, 64px);
    align-items: center;
  }

  .historia-figura {
    margin: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--rm-papel-2);
  }

  .historia-figura img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ════════════════════════════════ PACIOLI ════════════════════════════════ */
  .filial {
    padding-block: clamp(44px, 6vw, 84px);
    background: var(--rm-papel-2);
    border-block: 1px solid var(--rm-linea);
  }

  .filial-grid {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: start;
  }

  .filial-texto { margin-top: 0; }

  .filial-logo {
    width: 220px;
    height: auto;
    padding: 18px 22px;
    background: var(--rm-papel);
  }

  /* ══════════════════════════════ MISIÓN Y VISIÓN ══════════════════════════ */
  .mvv { padding-block: clamp(44px, 6vw, 88px); }

  .mvv-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: clamp(22px, 3vw, 46px);
  }

  .mvv-bloque {
    padding-top: 18px;
    border-top: 2px solid var(--rm-tinta);
  }

  .mvv-et { margin: 0 0 12px; }

  .mvv-texto {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--rm-tinta-2);
    text-align: justify;
    hyphens: auto;
  }

  .valores {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 clamp(18px, 2.4vw, 34px);
    list-style: none;
    margin: clamp(30px, 3.6vw, 48px) 0 0;
    padding: 0;
  }

  .valor {
    padding: 16px 0;
    border-top: 1px solid var(--rm-linea);
  }

  .valor-nombre {
    margin: 0 0 4px;
    font-family: var(--rm-serif);
    font-weight: 500;
    font-size: 17px;
    line-height: 1.3;
  }

  .valor-desc {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--rm-tinta-2);
  }

  /* ═════════════════════════════════ CITA ═════════════════════════════════ */
  .cita {
    padding-block: clamp(44px, 6vw, 88px);
    background: var(--rm-banda);
    color: var(--rm-papel);
  }

  .cita-texto {
    margin: 0;
    max-width: 22ch;
    font-family: var(--rm-serif);
    font-weight: 400;
    font-size: clamp(24px, 3.4vw, 46px);
    line-height: 1.25;
  }

  /* ═════════════════════════════════ SOCIO ═════════════════════════════════ */
  .socio { padding-block: clamp(44px, 6vw, 88px); }

  .socio-grid {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(24px, 3.4vw, 48px);
    align-items: center;
  }

  /* Monograma mientras el cliente no entregue el retrato */
  .monograma {
    display: grid;
    place-items: center;
    width: clamp(96px, 11vw, 140px);
    aspect-ratio: 1;
    border: 1px solid var(--rm-linea);
    font-family: var(--rm-display);
    font-size: clamp(30px, 3.4vw, 44px);
    letter-spacing: 0.02em;
    color: var(--rm-ambar);
    margin: 0;
  }

  .socio-nombre {
    margin: 8px 0 0;
    font-family: var(--rm-serif);
    font-weight: 500;
    font-size: clamp(24px, 2.6vw, 36px);
    line-height: 1.2;
  }

  .socio-texto { margin-top: 12px; }

  /* ════════════════════════════════ EQUIPO ════════════════════════════════ */
  .equipo {
    padding-block: clamp(44px, 6vw, 88px);
    background: var(--rm-papel-2);
    border-top: 1px solid var(--rm-linea);
  }

  .equipo-areas {
    display: grid;
    gap: clamp(24px, 3vw, 40px);
    margin-top: clamp(30px, 3.6vw, 48px);
  }

  .equipo-grupo {
    display: grid;
    grid-template-columns: minmax(140px, 200px) minmax(0, 1fr);
    gap: clamp(14px, 2.4vw, 32px);
    align-items: start;
  }

  .equipo-area {
    margin: 0;
    padding-top: 16px;
    border-top: 2px solid var(--rm-tinta);
  }

  .equipo-lista {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 0 clamp(18px, 2.4vw, 34px);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .persona {
    padding: 16px 0;
    border-top: 1px solid var(--rm-linea);
  }

  .persona--foto {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 14px;
    align-items: start;
  }

  .persona-foto {
    width: 64px;
    height: 64px;
    object-fit: cover;
    display: block;
    background: var(--rm-papel);
  }

  .persona-nombre {
    margin: 0 0 3px;
    font-family: var(--rm-serif);
    font-size: 17px;
    line-height: 1.3;
  }

  .persona-credencial {
    margin: 0 0 8px;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--rm-tinta-2);
  }

  .persona-correo {
    font-family: var(--rm-mono);
    font-size: 12.5px;
    color: var(--rm-azul);
    text-decoration: none;
  }

  .persona-correo:hover { text-decoration: underline; text-underline-offset: 4px; }

  /* ════════════════════════════════ CIERRE ════════════════════════════════ */
  .cierre { padding-block: clamp(44px, 6vw, 88px); }

  .cierre-grid {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: clamp(20px, 3vw, 40px);
  }

  /* ══════════════════════════════ Adaptación ══════════════════════════════ */
  @media (max-width: 900px) {
    .historia-grid { grid-template-columns: 1fr; }
    .historia-figura { aspect-ratio: 16 / 10; }
    .filial-grid { grid-template-columns: 1fr; }
    .valores { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .equipo-grupo { grid-template-columns: 1fr; gap: 10px; }
  }

  @media (max-width: 560px) {
    .socio-grid { grid-template-columns: 1fr; }
    .valores { grid-template-columns: 1fr; }
    .cita-texto { max-width: none; }
  }
</style>
