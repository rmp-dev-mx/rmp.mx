---
import Base from "@layouts/Base.astro";
import Cabecera from "@components/Cabecera.astro";
import InfografiaVisual from "@components/InfografiaVisual.astro";
import { getLang, localizedUrl } from "../../i18n/utils";
import { getBoletin } from "../../i18n/boletin";

const lang = getLang(Astro.currentLocale);
const b = getBoletin(lang);

const destacada = b.infografias.find((i) => i.destacada) ?? b.infografias[0];
const resto = b.infografias.filter((i) => i !== destacada);
---

<Base title={b.metaTitle} description={b.metaDesc} translated={true} fuentes="nuevo">
  <div class="mundo">

    <Cabecera titulo={["Resiliencia"]} sub={b.heroSub}>
      <p class="meta-ia">
        <span class="chip-ia" aria-hidden="true">IA</span>
        <span>{b.heroMetaPre}<strong>{b.heroMetaStrong}</strong>{b.heroMetaPost}</span>
      </p>
    </Cabecera>

    <!-- Aviso honesto: la muestra no es información fiscal real -->
    <p class="aviso">
      <span class="aviso-tag">{b.demoTag}</span>
      <span>{b.demoTextoPre}<strong>{b.demoTextoStrong}</strong>{b.demoTextoPost}</span>
    </p>

    <section class="feed" aria-label={b.feedAria}>
      <div class="marco">

        <article class="destacada">
          <div class="destacada-visual">
            <InfografiaVisual visual={destacada.visual} grande={true} />
          </div>
          <div class="destacada-texto">
            <p class="dato pieza-meta">{destacada.categoria} · {destacada.periodo}</p>
            <h2 class="destacada-titulo">{destacada.titulo}</h2>
            <p class="destacada-resumen">{destacada.resumen}</p>
            <p class="dato firma-ia">
              <span class="chip-ia chip-ia--chico" aria-hidden="true">IA</span>
              {b.firmaDestacada}
            </p>
          </div>
        </article>

        <ul class="rejilla" role="list">
          {resto.map((ig) => (
            <li class="pieza">
              <div class="pieza-visual">
                <InfografiaVisual visual={ig.visual} grande={false} />
              </div>
              <p class="dato pieza-meta">{ig.categoria} · {ig.periodo}</p>
              <h3 class="pieza-titulo">{ig.titulo}</h3>
              <p class="pieza-resumen">{ig.resumen}</p>
              <p class="dato firma-ia">
                <span class="chip-ia chip-ia--chico" aria-hidden="true">IA</span>
                {b.firmaCard}
              </p>
            </li>
          ))}
        </ul>

        <p class="nota">
          {b.feedNotaPre}
          <a href={localizedUrl("/contacto", lang)}>{b.feedNotaLink}</a>
          {b.feedNotaPost}
        </p>
      </div>
    </section>

  </div>
</Base>

<style>
  .meta-ia {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-top: clamp(18px, 2vw, 26px);
    max-width: 52ch;
    font-size: 15px;
    line-height: 1.6;
    color: var(--rm-tinta-2);
  }

  .meta-ia strong { color: var(--rm-tinta); font-weight: 600; }

  .chip-ia {
    flex: none;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--rm-ambar);
    color: var(--rm-papel);
    font-family: var(--rm-mono);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .chip-ia--chico { width: 20px; height: 20px; font-size: 9px; }

  .aviso {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
    padding: 16px clamp(20px, 4vw, 64px);
    background: var(--rm-papel-2);
    border-bottom: 1px solid var(--rm-linea);
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--rm-tinta-2);
  }

  .aviso strong { color: var(--rm-tinta); font-weight: 600; }

  .aviso-tag {
    font-family: var(--rm-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--rm-papel);
    background: var(--rm-ambar);
    padding: 5px 10px;
  }

  .feed { padding-block: clamp(44px, 6vw, 88px); }

  /* La pieza destacada abre el feed a doble columna */
  .destacada {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(20px, 3vw, 48px);
    align-items: center;
    padding-bottom: clamp(32px, 4vw, 56px);
    margin-bottom: clamp(32px, 4vw, 56px);
    border-bottom: 1px solid var(--rm-linea);
  }

  .destacada-visual,
  .pieza-visual {
    background: var(--rm-tinta);
    color: var(--rm-papel);
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .destacada-visual { aspect-ratio: 4 / 3; }
  .pieza-visual { aspect-ratio: 16 / 10; margin-bottom: 18px; }

  .destacada-titulo {
    font-family: var(--rm-serif);
    font-weight: 500;
    font-size: clamp(24px, 2.6vw, 36px);
    line-height: 1.2;
    margin: 10px 0 14px;
  }

  .destacada-resumen {
    font-size: 16px;
    line-height: 1.6;
    color: var(--rm-tinta-2);
    max-width: 48ch;
    margin-bottom: 18px;
  }

  .rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: clamp(24px, 3vw, 44px);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pieza-meta { margin: 0 0 6px; font-size: 11.5px; }

  .pieza-titulo {
    font-family: var(--rm-serif);
    font-weight: 500;
    font-size: clamp(19px, 1.5vw, 23px);
    line-height: 1.25;
    margin: 0 0 10px;
  }

  .pieza-resumen {
    margin: 0 0 14px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--rm-tinta-2);
  }

  .firma-ia {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 0;
    font-size: 11px;
  }

  .nota {
    margin-top: clamp(32px, 4vw, 52px);
    padding-top: 22px;
    border-top: 1px solid var(--rm-linea);
    max-width: 62ch;
    font-size: 15px;
    line-height: 1.6;
    color: var(--rm-tinta-2);
  }

  .nota a { color: var(--rm-ambar); text-underline-offset: 4px; }

  @media (max-width: 860px) {
    .destacada { grid-template-columns: 1fr; }
  }
</style>
