---
import Base from "@layouts/Base.astro";
import Cabecera from "@components/Cabecera.astro";
import { url } from "../../lib/url";
import { getLang, localizedUrl } from "../../i18n/utils";
import { getServicios } from "../../i18n/servicios";
import { getHome } from "../../i18n/home";

const lang = getLang(Astro.currentLocale);
const s = getServicios(lang);
const h = getHome(lang);

// La encargada y la foto de cada área ya viven en el diccionario de la
// portada: se toman de ahí para no tener dos versiones del mismo dato.
const encargadas = Object.fromEntries(h.areas.map((a) => [a.id, a]));

const FLECHA = '<path d="M5 12h13"/><path d="m12.5 6 6 6-6 6"/>';
const ABAJO = '<path d="M12 5v13"/><path d="m6 12.5 6 6 6-6"/>';
---

<Base title={s.metaTitle} description={s.metaDesc} translated={true} fuentes="nuevo">
  <div class="mundo">

    <Cabecera titulo={s.heroH1} sub={s.heroSub} foto={s.heroFoto} alt={s.heroAlt}>
      <nav class="indice" aria-label={s.indiceAria}>
        {s.areas.map((a) => (
          <a class="indice-fila" href={`#${a.id}`} aria-label={s.irAlArea(a.titulo)}>
            <span class="indice-nombre">{a.titulo}</span>
            <span class="indice-linea" aria-hidden="true"></span>
            <span class="dato indice-cuenta">{s.partidas(a.servicios.length)}</span>
            <svg class="ico indice-flecha" viewBox="0 0 24 24" aria-hidden="true" set:html={ABAJO} />
          </a>
        ))}
      </nav>
    </Cabecera>

    <!-- ══════════════════════════════════════════ APARTADOS ══ -->
    {s.areas.map((a, i) => {
      const e = encargadas[a.id];
      return (
        <section id={a.id} class:list={["apartado", { "apartado--alterno": i % 2 === 1 }]} aria-labelledby={`${a.id}-titulo`}>
          <div class="marco apartado-grid">

            <div class="apartado-cabeza">
              <figure class="apartado-figura">
                <img
                  src={url(e.foto)}
                  alt=""
                  width="2048"
                  height="2048"
                  loading="lazy"
                  decoding="async"
                />
              </figure>

              <h2 class="titulo-seccion apartado-titulo" id={`${a.id}-titulo`}>{a.titulo}</h2>
              <p class="apartado-intro">{a.intro}</p>

              <div class="apartado-responde">
                <p class="dato">{s.respondeEt} · {e.encargada}</p>
                <a
                  class="apartado-correo"
                  href={`mailto:${e.correo}`}
                  aria-label={s.escribirAria(e.primer, a.titulo)}
                >{s.escribirA(e.primer)}</a>
              </div>
            </div>

            <ol class="partidas" role="list">
              {a.servicios.map((sv) => (
                <li class="partida">
                  <p class="partida-nombre">{sv.n}</p>
                  <p class="partida-desc">{sv.d}</p>
                </li>
              ))}
            </ol>

          </div>
        </section>
      );
    })}

    <!-- ════════════════════════════════════════════ CONTACTO ══ -->
    <section class="cierre" aria-labelledby="cierre-titulo">
      <div class="marco cierre-grid">
        <h2 class="titulo-seccion" id="cierre-titulo">{s.ctaTitulo[0]} {s.ctaTitulo[1]}</h2>
        <a class="boton" href={localizedUrl("/contacto", lang)}>
          <span>{s.ctaAgenda}</span>
          <span class="accion-circulo" aria-hidden="true">
            <svg class="ico" viewBox="0 0 24 24" set:html={FLECHA} />
          </span>
        </a>
      </div>
    </section>

  </div>
</Base>

<style>
  /* Índice: el renglón lleva al apartado */
  .indice {
    margin-top: clamp(28px, 3.4vw, 44px);
    max-width: 46ch;
  }

  .indice-fila {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: baseline;
    gap: 12px;
    padding: 13px 0;
    border-top: 1px solid var(--rm-linea);
    color: var(--rm-tinta);
    text-decoration: none;
  }

  .indice-fila:last-child { border-bottom: 1px solid var(--rm-linea); }

  .indice-nombre {
    font-family: var(--rm-serif);
    font-size: clamp(18px, 1.5vw, 22px);
    transition: color 0.3s ease;
  }

  .indice-linea {
    border-bottom: 1px dotted var(--rm-linea);
    transform: translateY(-4px);
  }

  .indice-cuenta { font-size: 11.5px; }

  .indice-flecha {
    align-self: center;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .indice-fila:hover .indice-nombre { color: var(--rm-ambar); }
  .indice-fila:hover .indice-flecha { transform: translateY(3px); }

  /* ══════════════════════════════ APARTADOS ══════════════════════════════ */
  .apartado {
    padding-block: clamp(48px, 6.5vw, 96px);
    border-bottom: 1px solid var(--rm-linea);
    scroll-margin-top: 80px;
  }

  .apartado--alterno { background: var(--rm-papel-2); }

  .apartado-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(26px, 4vw, 64px);
    align-items: start;
  }

  .apartado-figura {
    margin: 0 0 24px;
    aspect-ratio: 5 / 4;
    overflow: hidden;
    background: var(--rm-papel);
  }

  .apartado-figura img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .apartado-intro {
    margin-top: 16px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--rm-tinta-2);
    max-width: 40ch;
  }

  .apartado-responde {
    margin-top: 22px;
    padding-top: 16px;
    border-top: 1px solid var(--rm-linea);
  }

  .apartado-correo {
    display: inline-block;
    margin-top: 6px;
    font-family: var(--rm-mono);
    font-size: 12.5px;
    letter-spacing: 0.06em;
    color: var(--rm-ambar);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }

  /* Las partidas: un renglón por servicio, sin cajas */
  .partidas {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: partida;
  }

  .partida {
    display: grid;
    gap: 4px;
    padding: 16px 0;
    border-top: 1px solid var(--rm-linea);
  }

  .partida:first-child { border-top: 2px solid var(--rm-tinta); }

  .partida-nombre {
    margin: 0;
    font-family: var(--rm-serif);
    font-size: clamp(17px, 1.35vw, 19px);
    line-height: 1.35;
    color: var(--rm-tinta);
  }

  .partida-desc {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--rm-tinta-2);
    max-width: 62ch;
  }

  /* ═══════════════════════════════ CIERRE ═══════════════════════════════ */
  .cierre { padding-block: clamp(48px, 7vw, 96px); }

  .cierre-grid {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: clamp(20px, 3vw, 40px);
  }

  /* ══════════════════════════════ Adaptación ══════════════════════════════ */
  @media (max-width: 900px) {
    .apartado-grid { grid-template-columns: 1fr; }
    .apartado-figura { aspect-ratio: 16 / 9; }
  }

  @media (max-width: 560px) {
    .indice-fila { grid-template-columns: 1fr auto auto; }
    .indice-linea { display: none; }
    .apartado-intro { max-width: none; }
  }
</style>
