---
import Base from "@layouts/Base.astro";
import { url } from "../../lib/url";
import { getLang, localizedUrl } from "../../i18n/utils";
import { getHome } from "../../i18n/home";

const lang = getLang(Astro.currentLocale);
const h = getHome(lang);

// Íconos dibujados, trazo único de 1.6 en caja de 24.
const FLECHA = '<path d="M5 12h13"/><path d="m12.5 6 6 6-6 6"/>';
---

<Base title={h.metaTitle} description={h.metaDesc} translated={true} fuentes="nuevo">
  <div class="mundo">

    <!-- ═════════════════════════════════════════════ PORTADA ══ -->
    <section class="portada" aria-labelledby="titular">
      <div class="portada-texto">
        <p class="rail" aria-hidden="true">{h.rail}</p>

        <div class="portada-cuerpo">
          <h1 class="titular" id="titular">
            {h.titular.map((l) => <span class="titular-linea">{l}</span>)}
          </h1>
          <p class="acento portada-acento">{h.acento}</p>
          <p class="portada-entrada">{h.entrada}</p>

          <a class="boton portada-boton" href={localizedUrl("/contacto", lang)}>
            <span>{h.cta}</span>
            <span class="accion-circulo" aria-hidden="true">
              <svg class="ico" viewBox="0 0 24 24" set:html={FLECHA} />
            </span>
          </a>

          <p class="dato portada-dato">
            {h.contactoDomicilio[0]} · {h.contactoDomicilio[2]}
          </p>
        </div>
      </div>

      <figure class="portada-figura">
        <img
          src={url(h.heroFoto)}
          alt={h.heroAlt}
          width="2752"
          height="1536"
          fetchpriority="high"
          decoding="async"
        />
      </figure>
    </section>

    <!-- ═══════════════════════════════════════════════ ÁREAS ══ -->
    <section class="areas" aria-labelledby="areas-titulo">
      <div class="marco">
        <header class="areas-cabeza">
          <h2 class="titulo-seccion" id="areas-titulo">{h.areasTitulo}</h2>
          <p class="areas-sub">{h.areasSub}</p>
          <a class="accion areas-accion" href={localizedUrl("/servicios", lang)}>
            <span>{h.verAreas}</span>
            <span class="accion-circulo" aria-hidden="true">
              <svg class="ico" viewBox="0 0 24 24" set:html={FLECHA} />
            </span>
          </a>
        </header>

        <ul class="areas-lista" role="list">
          {h.areas.map((a) => (
            <li class="area">
              <span class="area-foto">
                <img
                  src={url(a.foto)}
                  alt=""
                  width="2048"
                  height="2048"
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <h3 class="area-nombre">
                <a href={localizedUrl(`/servicios#${a.id}`, lang)}>{a.nombre}</a>
              </h3>
              <p class="area-alcance">{a.alcance}</p>
              <p class="dato area-responde">{h.respondeEt} · {a.encargada}</p>
              <a
                class="area-correo"
                href={`mailto:${a.correo}`}
                aria-label={h.escribirAria(a.primer, a.nombre)}
              >{h.escribirA(a.primer)}</a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════ FRANJA ══ -->
    <section class="franja" aria-labelledby="cita-titulo">
      <div class="franja-texto">
        <div class="franja-cuerpo">
          <p class="dato franja-et">{h.citaEt}</p>
          <blockquote class="franja-cita" id="cita-titulo">{h.cita}</blockquote>
          <a class="accion franja-accion" href={localizedUrl("/nosotros", lang)}>
            <span>{h.citaCta}</span>
            <span class="accion-circulo" aria-hidden="true">
              <svg class="ico" viewBox="0 0 24 24" set:html={FLECHA} />
            </span>
          </a>
        </div>
      </div>
      <figure class="franja-figura">
        <img
          src={url(h.citaFoto)}
          alt={h.citaAlt}
          width="1856"
          height="2304"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </section>

    <!-- ══════════════════════════════════════════════ CIFRAS ══ -->
    <section class="cifras" aria-label={h.areasTitulo}>
      <div class="marco">
        <ul class="cifras-lista" role="list">
          {h.cifras.map((c) => (
            <li class="cifra">
              <p class="cifra-dato">{c.dato}</p>
              <p class="dato cifra-pie">{c.pie}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ════════════════════════════════════════════ CONTACTO ══ -->
    <section class="contacto" aria-labelledby="contacto-titulo">
      <div class="marco contacto-grid">
        <div>
          <h2 class="titulo-seccion" id="contacto-titulo">{h.contactoTitulo}</h2>
          <a class="boton contacto-boton" href={localizedUrl("/contacto", lang)}>
            <span>{h.contactoCta}</span>
            <span class="accion-circulo" aria-hidden="true">
              <svg class="ico" viewBox="0 0 24 24" set:html={FLECHA} />
            </span>
          </a>
          <p class="contacto-nota">{h.contactoNota}</p>
        </div>

        <div class="contacto-datos">
          <div>
            <p class="dato contacto-et">{h.contactoEtDomicilio}</p>
            <address class="contacto-valor">
              {h.contactoDomicilio.map((l) => <span>{l}</span>)}
            </address>
          </div>
          <div>
            <p class="dato contacto-et">{h.contactoEtTelefonos}</p>
            <ul class="contacto-valor" role="list">
              {h.contactoTelefonos.map((t) => (
                <li><a href={`tel:${t.tel}`}>{t.texto}</a></li>
              ))}
            </ul>
          </div>
          <div>
            <p class="dato contacto-et">{h.contactoEtCorreo}</p>
            <p class="contacto-valor">
              <a href={`mailto:${h.contactoCorreo}`}>{h.contactoCorreo}</a>
            </p>
          </div>
        </div>
      </div>
    </section>

  </div>
</Base>

<style>
  /* ═══════════════════════════════ PORTADA ═══════════════════════════════ */
  .portada {
    display: grid;
    grid-template-columns: minmax(0, 0.96fr) minmax(0, 1.04fr);
    align-items: stretch;
    min-height: min(86vh, 860px);
    border-bottom: 1px solid var(--rm-linea);
  }

  .portada-texto {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: clamp(16px, 2.4vw, 34px);
    padding: clamp(36px, 5vw, 78px) clamp(20px, 3.4vw, 56px) clamp(36px, 5vw, 70px)
      clamp(20px, 4vw, 64px);
  }

  /* Riel vertical: el dato que acompaña al titular sin competir con él */
  .rail {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    justify-self: start;
    align-self: center;
    font-family: var(--rm-mono);
    font-size: 11.5px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--rm-tinta-2);
    padding-block: 18px;
    border-inline-end: 1px solid var(--rm-linea);
    padding-inline-end: 14px;
  }

  .titular-linea { display: block; }

  .portada-acento {
    margin-top: clamp(14px, 1.8vw, 24px);
    font-style: italic;
  }

  .portada-entrada {
    margin-top: clamp(16px, 1.8vw, 22px);
    max-width: 34ch;
    font-size: clamp(16px, 1.25vw, 18px);
    line-height: 1.6;
    color: var(--rm-tinta-2);
  }

  .portada-boton { margin-top: clamp(26px, 3vw, 38px); }

  .portada-dato {
    margin-top: clamp(26px, 3.4vw, 44px);
    padding-top: 14px;
    border-top: 1px solid var(--rm-linea);
    max-width: 30ch;
  }

  .portada-figura {
    position: relative;
    margin: 0;
    overflow: hidden;
    background: var(--rm-papel-2);
  }

  .portada-figura img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 38%;
    display: block;
  }

  /* El papel entra sobre la foto para que no quede un corte duro */
  .portada-figura::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 22%;
    background: linear-gradient(to right, var(--rm-papel), transparent);
    z-index: 1;
    pointer-events: none;
  }

  /* ═════════════════════════════════ ÁREAS ═════════════════════════════════ */
  .areas { padding-block: clamp(56px, 8vw, 112px); }

  .areas-cabeza {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: clamp(16px, 2vw, 32px);
    margin-bottom: clamp(32px, 4vw, 56px);
  }

  .areas-sub {
    grid-column: 1;
    margin-top: 14px;
    font-size: clamp(15px, 1.15vw, 17px);
    line-height: 1.6;
    color: var(--rm-tinta-2);
    max-width: 46ch;
  }

  .areas-accion { grid-column: 2; grid-row: 1 / span 2; align-self: end; }

  .areas-lista {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(18px, 2.2vw, 34px);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .area-foto {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--rm-papel-2);
    margin-bottom: 18px;
  }

  .area-foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .area:hover .area-foto img { transform: scale(1.03); }

  .area-nombre {
    font-family: var(--rm-serif);
    font-weight: 500;
    font-size: clamp(21px, 1.7vw, 26px);
    line-height: 1.15;
    margin: 0 0 8px;
  }

  .area-nombre a {
    color: inherit;
    text-decoration: none;
    background-image: linear-gradient(var(--rm-ambar), var(--rm-ambar));
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .area:hover .area-nombre a { background-size: 100% 1px; }

  .area-alcance {
    margin: 0 0 16px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--rm-tinta-2);
    max-width: 30ch;
  }

  .area-responde {
    margin: 0 0 6px;
    padding-top: 14px;
    border-top: 1px solid var(--rm-linea);
    font-size: 11.5px;
  }

  .area-correo {
    font-family: var(--rm-mono);
    font-size: 12.5px;
    letter-spacing: 0.06em;
    color: var(--rm-ambar);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }

  /* ════════════════════════════════ FRANJA ════════════════════════════════ */
  .franja {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    background: var(--rm-banda);
    color: var(--rm-papel);
    --foco: var(--rm-papel);
  }

  .franja-texto {
    display: grid;
    align-items: center;
    padding: clamp(48px, 6vw, 96px) clamp(20px, 4vw, 72px);
  }

  .franja-cuerpo { max-width: 42ch; }

  .franja-et {
    color: rgb(244 237 226 / 0.85);
    margin-bottom: clamp(18px, 2vw, 26px);
  }

  .franja-cita {
    font-family: var(--rm-serif);
    font-weight: 400;
    font-size: clamp(21px, 2.3vw, 33px);
    line-height: 1.3;
    margin: 0 0 clamp(26px, 3vw, 38px);
  }

  .franja-accion { color: var(--rm-papel); }
  .franja-accion .accion-circulo { border-color: var(--rm-papel); }
  .franja-accion:hover .accion-circulo {
    background: var(--rm-papel);
    color: var(--rm-banda);
  }

  .franja-figura {
    position: relative;
    margin: 0;
    overflow: hidden;
    min-height: 420px;
  }

  .franja-figura img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 45%;
    display: block;
  }

  /* ════════════════════════════════ CIFRAS ════════════════════════════════ */
  .cifras { padding-block: clamp(44px, 6vw, 84px); }

  .cifras-lista {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 32px);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cifra {
    padding-top: 18px;
    border-top: 1px solid var(--rm-linea);
  }

  .cifra-dato {
    font-family: var(--rm-display);
    font-weight: 500;
    font-size: clamp(30px, 3vw, 44px);
    line-height: 1;
    letter-spacing: -0.02em;
    margin: 0 0 10px;
    font-variant-numeric: tabular-nums;
  }

  .cifra-pie { margin: 0; }

  /* ═══════════════════════════════ CONTACTO ═══════════════════════════════ */
  .contacto {
    padding-block: clamp(48px, 7vw, 100px);
    background: var(--rm-papel-2);
    border-top: 1px solid var(--rm-linea);
  }

  .contacto-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(28px, 4vw, 64px);
    align-items: start;
  }

  .contacto-boton { margin-top: clamp(22px, 2.6vw, 32px); }

  .contacto-nota {
    margin-top: 16px;
    max-width: 32ch;
    font-size: 15px;
    line-height: 1.55;
    color: var(--rm-tinta-2);
  }

  .contacto-datos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: clamp(20px, 2.4vw, 36px);
  }

  .contacto-et {
    margin-bottom: 10px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--rm-linea);
  }

  .contacto-valor {
    display: grid;
    gap: 3px;
    font-style: normal;
    font-size: 16px;
    line-height: 1.5;
    list-style: none;
    margin: 0;
    padding: 0;
    font-variant-numeric: tabular-nums;
  }

  .contacto-valor a {
    color: var(--rm-azul);
    text-decoration: none;
  }

  .contacto-valor a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* ══════════════ El momento autorizado: la portada se compone ══════════════ */
  @media (prefers-reduced-motion: no-preference) {
    .titular-linea,
    .portada-acento,
    .portada-entrada,
    .portada-boton,
    .portada-dato {
      animation: entra 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .titular-linea:nth-child(2) { animation-delay: 0.08s; }
    .portada-acento { animation-delay: 0.18s; }
    .portada-entrada { animation-delay: 0.26s; }
    .portada-boton { animation-delay: 0.34s; }
    .portada-dato { animation-delay: 0.42s; }

    .portada-figura img { animation: asienta 1.4s cubic-bezier(0.16, 1, 0.3, 1) both; }
  }

  @keyframes entra {
    from { transform: translateY(14px); clip-path: inset(0 0 100% 0); }
    to { transform: translateY(0); clip-path: inset(0 0 -10% 0); }
  }

  @keyframes asienta {
    from { transform: scale(1.06); }
    to { transform: scale(1); }
  }

  /* ══════════════════════════════ Adaptación ══════════════════════════════ */
  @media (max-width: 1100px) {
    .areas-lista { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cifras-lista { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 900px) {
    .portada {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .portada-figura { order: -1; aspect-ratio: 16 / 10; }
    .portada-figura::before { inset: auto 0 0 auto; width: 100%; height: 30%;
      background: linear-gradient(to top, var(--rm-papel), transparent); }
    .franja { grid-template-columns: 1fr; }
    .franja-figura { order: -1; aspect-ratio: 16 / 9; min-height: 0; }
    .contacto-grid { grid-template-columns: 1fr; }
    .areas-cabeza { grid-template-columns: 1fr; }
    .areas-accion { grid-column: 1; grid-row: auto; justify-self: start; }
  }

  @media (max-width: 560px) {
    .rail { display: none; }
    .portada-texto { grid-template-columns: 1fr; }
    .areas-lista { grid-template-columns: 1fr; gap: 34px; }
    .area-alcance, .portada-entrada { max-width: none; }
  }
</style>
