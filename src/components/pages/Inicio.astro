---
import Base from "@layouts/Base.astro";
import { url } from "../../lib/url";
import { getLang, localizedUrl } from "../../i18n/utils";
import { getHome } from "../../i18n/home";
import { getNosotros } from "../../i18n/nosotros";

const lang = getLang(Astro.currentLocale);
const h = getHome(lang);
const equipo = getNosotros(lang).equipo;

// Sistema de íconos: trazo único de 1.5, caja de 24. Dibujados, nunca glifos.
const ICO = {
  sobre:
    '<rect x="3" y="5.5" width="18" height="13" rx="1.5"/><path d="m3.6 6.6 8.4 6.2 8.4-6.2"/>',
  telefono:
    '<path d="M8.4 4.5H5.2A1.7 1.7 0 0 0 3.5 6.3c0 7.8 6.4 14.2 14.2 14.2a1.7 1.7 0 0 0 1.8-1.7v-3.2l-4-1.6-2 2a13.6 13.6 0 0 1-5.5-5.5l2-2z"/>',
  flecha: '<path d="M4.5 12h14"/><path d="m13 6.5 5.5 5.5L13 17.5"/>',
};

// Los cuatro tornillos de una placa, con la ranura en otro ángulo cada uno.
const RANURAS = [
  "M8.5 13.6 15.5 10.4",
  "M9.4 9.1 14.6 14.9",
  "M9.4 14.9 14.6 9.1",
  "M8.5 10.9 15.5 13.1",
];
---

<Base title={h.metaTitle} description={h.metaDesc} translated={true} fuentes="placa">
  <div class="mundo-placa">

    <!-- ══════════════════════════════════════════ LA PLACA ══ -->
    <section class="portada" aria-labelledby="firma-nombre">
      <div class="marco portada-grid">

        <div class="portada-col">
          <!-- Placa mayor: metal oscuro, cuatro caras de canto reales -->
          <div class="placa placa--oscura placa-mayor">
            {RANURAS.map((d, i) => (
              <svg class={`tornillo tornillo--${i}`} viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="7"></circle>
                <path d={d}></path>
              </svg>
            ))}

            <div class="placa-mayor-cuerpo">
              <h1 class="firma" id="firma-nombre">{h.firma}</h1>
              <p class="profesiones">{h.profesiones}</p>
              <hr class="filete" />
              <p class="fundacion">
                <span>{h.desde}</span>
                <span class="punto" aria-hidden="true"></span>
                <span>{h.anios}</span>
                <span class="punto" aria-hidden="true"></span>
                <span>{h.lugar}</span>
              </p>
            </div>
          </div>

          <p class="entrada">{h.entrada}</p>
        </div>

        <!-- Cuatro placas de área: cada una nombra a su encargada y el
             enlace escribe directo a ella -->
        <ul class="areas" role="list">
          {h.areas.map((a) => (
            <li class="area">
              <article class="placa placa--clara placa-area">
                {RANURAS.map((d, i) => (
                  <svg class={`tornillo tornillo--${i}`} viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="12" cy="12" r="7"></circle>
                    <path d={d}></path>
                  </svg>
                ))}

                <h2 class="area-nombre">{a.nombre}</h2>
                <p class="area-alcance">{a.alcance}</p>

                <div class="area-responde">
                  <p class="area-responde-et">{h.areaEncargadaEtiqueta}</p>
                  <p class="area-encargada">{a.encargada}</p>
                  <a
                    class="area-accion"
                    href={`mailto:${a.correo}`}
                    aria-label={h.areaEscribirAria(a.primer, a.nombre)}
                  >
                    <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" set:html={ICO.sobre} />
                    <span>{h.areaEscribir(a.primer)}</span>
                  </a>
                  <p class="area-correo-dir">{a.correo}</p>
                </div>

                <a
                  class="area-detalle"
                  href={localizedUrl(`/servicios#${a.id}`, lang)}
                  aria-label={h.areaDetalleAria(a.nombre)}
                >{h.areaDetalle}</a>
              </article>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ══════════════════════════════════════════ EL PADRÓN ══ -->
    <section class="padron" aria-labelledby="padron-titulo">
      <div class="marco">
        <header class="seccion-cabeza">
          <h2 class="seccion-titulo" id="padron-titulo">{h.padronTitulo}</h2>
          <p class="seccion-bajada">{h.padronIntro}</p>
        </header>

        <div class="registro">
          {equipo.map((grupo) => (
            <section class="registro-grupo" aria-label={grupo.area}>
              <h3 class="registro-area">{grupo.area}</h3>
              <ul class="registro-lista" role="list">
                {grupo.personas.map((p) => (
                  <li class="renglon">
                    <p class="renglon-nombre">{p.nombre}</p>
                    <p class="renglon-credencial">{p.credencial}</p>
                    <a
                      class="renglon-correo"
                      href={`mailto:${p.correo}`}
                      aria-label={h.padronCorreoAria(p.nombre)}
                    >
                      <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" set:html={ICO.sobre} />
                      <span>{p.correo}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>

        <p class="padron-pie">
          <a class="enlace-grabado" href={localizedUrl("/nosotros", lang)}>
            <span>{h.padronCta}</span>
            <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" set:html={ICO.flecha} />
          </a>
        </p>
      </div>
    </section>

    <!-- ═════════════════════════════════════════ CONTINUIDAD ══ -->
    <section class="continuidad" aria-labelledby="continuidad-titulo">
      <div class="marco">
        <h2 class="seccion-titulo seccion-titulo--claro" id="continuidad-titulo">
          {h.continuidadTitulo}
        </h2>

        <ul class="hechos" role="list">
          {h.continuidad.map((c) => (
            <li class="hecho">
              <p class="hecho-dato">{c.dato}</p>
              <p class="hecho-texto">{c.texto}</p>
              {c.dato === "Pacioli" && (
                <span class="placa placa--clara hecho-logo">
                  <img
                    src={url("/images/pacioli.svg")}
                    alt="Pacioli Asesores de Negocios, S.C."
                    width="150"
                    height="46"
                    loading="lazy"
                    decoding="async"
                  />
                </span>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ════════════════════════════════════════════ BOLETÍN ══ -->
    <section class="boletin" aria-labelledby="boletin-titulo">
      <div class="marco marco--angosto">
        <h2 class="seccion-titulo" id="boletin-titulo">{h.boletinTitulo}</h2>
        <p class="boletin-desc">{h.boletinDesc}</p>
        <a class="enlace-grabado" href={localizedUrl("/boletin", lang)}>
          <span>{h.boletinCta}</span>
          <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" set:html={ICO.flecha} />
        </a>
      </div>
    </section>

    <!-- ═════════════════════════════════════════════ LA PUERTA ══ -->
    <section class="puerta" aria-labelledby="puerta-titulo">
      <div class="marco">
        <div class="puerta-grid">

          <div class="placa placa--oscura placa-domicilio">
            {RANURAS.map((d, i) => (
              <svg class={`tornillo tornillo--${i}`} viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="7"></circle>
                <path d={d}></path>
              </svg>
            ))}
            <h2 class="seccion-titulo seccion-titulo--claro" id="puerta-titulo">
              {h.puertaTitulo}
            </h2>
            <address class="domicilio">
              {h.puertaDomicilio.map((l) => <span>{l}</span>)}
            </address>
          </div>

          <div class="puerta-datos">
            <div class="dato">
              <p class="dato-et">{h.puertaTelefonosEtiqueta}</p>
              <ul class="tels" role="list">
                {h.puertaTelefonos.map((t) => (
                  <li>
                    <a class="tel" href={`tel:${t.tel}`}>
                      <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" set:html={ICO.telefono} />
                      <span>{t.texto}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>

            <div class="dato">
              <p class="dato-et">{h.puertaCorreoEtiqueta}</p>
              <a class="tel" href={`mailto:${h.puertaCorreo}`}>
                <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" set:html={ICO.sobre} />
                <span>{h.puertaCorreo}</span>
              </a>
            </div>

            <div class="dato">
              <a class="placa placa--oscura boton-placa" href={localizedUrl("/contacto", lang)}>
                <span>{h.puertaCta}</span>
                <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" set:html={ICO.flecha} />
              </a>
              <p class="puerta-nota">{h.puertaCtaNota}</p>
            </div>
          </div>

        </div>
      </div>
    </section>

  </div>
</Base>

<style>
  /* ═══════════════════════ Campo de cantera y base ═══════════════════════ */
  .mundo-placa {
    /* Muro de cantera en luz plana. La veta real es un asset pendiente:
       aquí no se imita con degradados que fingirían una piedra que no hay. */
    background-color: var(--pl-piedra);
    background-image: linear-gradient(
      172deg,
      var(--pl-piedra-alta) 0%,
      var(--pl-piedra) 46%,
      var(--pl-piedra-honda) 100%
    );
    color: var(--pl-azul);
    font-family: var(--pl-texto);
    --foco: var(--pl-azul);
  }

  .marco {
    max-width: 1180px;
    margin: 0 auto;
    padding-inline: clamp(16px, 4vw, 48px);
  }

  .marco--angosto { max-width: 760px; }

  /* ── La placa: la profundidad es el canto, cuatro caras mitradas ── */
  .placa {
    position: relative;
    border-style: solid;
    border-radius: 2px;
    box-shadow: var(--pl-apoyo);
  }

  .placa--oscura {
    border-width: 6px;
    border-color: var(--pl-canto-oscuro);
    background-image: linear-gradient(
      168deg,
      #0c4a8a 0%,
      var(--pl-azul) 34%,
      #0a3f79 52%,
      var(--pl-azul-hondo) 100%
    );
    color: var(--pl-piedra-alta);
  }

  .placa--clara {
    border-width: 5px;
    border-color: var(--pl-canto-claro);
    background-image: linear-gradient(
      168deg,
      #faf7f2 0%,
      var(--pl-piedra-alta) 38%,
      #ece6dd 54%,
      #e2dbd1 100%
    );
    color: var(--pl-azul);
    box-shadow: var(--pl-apoyo-corto);
  }

  /* Tornillos: mismo trazo que los íconos */
  .tornillo {
    position: absolute;
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    opacity: 0.55;
  }
  .tornillo--0 { top: 12px; left: 12px; }
  .tornillo--1 { top: 12px; right: 12px; }
  .tornillo--2 { bottom: 12px; left: 12px; }
  .tornillo--3 { bottom: 12px; right: 12px; }

  .ico {
    width: 17px;
    height: 17px;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ═══════════════════════════════ LA PLACA ═══════════════════════════════ */
  .portada {
    padding-block: clamp(40px, 6vw, 76px) clamp(48px, 8vw, 104px);
  }

  /* Contrato: la placa mayor a la izquierda, las cuatro de área a su derecha */
  .portada-grid {
    display: grid;
    gap: clamp(16px, 2vw, 26px);
    align-items: start;
  }

  .portada-col {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  @media (min-width: 1024px) {
    .portada-grid {
      grid-template-columns: minmax(0, 0.94fr) minmax(0, 1.06fr);
    }
    .portada-col .placa-mayor { flex: 1; display: flex; align-items: center; }
    .entrada { margin-bottom: 0; }
  }

  .placa-mayor {
    padding: clamp(32px, 5vw, 62px) clamp(24px, 5vw, 66px);
  }

  .placa-mayor-cuerpo { max-width: 22ch; }

  .firma {
    font-family: var(--pl-display);
    font-weight: 600;
    font-size: clamp(30px, 5.2vw, 66px);
    line-height: 1.04;
    letter-spacing: 0.02em;
    color: var(--pl-piedra-alta);
    margin: 0;
  }

  .profesiones {
    margin: clamp(14px, 1.6vw, 22px) 0 0;
    font-size: clamp(13px, 1.25vw, 17px);
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--pl-azul-tenue);
  }

  .filete {
    border: 0;
    border-top: 1px solid rgb(255 255 255 / 0.26);
    border-bottom: 1px solid rgb(0 0 0 / 0.32);
    margin: clamp(20px, 2.6vw, 34px) 0;
    max-width: 180px;
  }

  .fundacion {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    white-space: nowrap;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--pl-azul-claro);
  }

  .punto {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--pl-azul-claro);
  }

  .entrada {
    margin: clamp(22px, 2.4vw, 30px) 0 clamp(18px, 2vw, 26px);
    max-width: 52ch;
    font-size: clamp(16px, 1.5vw, 19px);
    line-height: 1.6;
    color: var(--pl-azul);
  }

  /* ── Placas de área ── */
  .areas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: clamp(14px, 1.6vw, 20px);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .placa-area {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 13px;
    padding: clamp(22px, 2.4vw, 30px);
    transition: border-color 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* El hundido es la respuesta de la acción, no del área entera: la placa
     sólo se hunde cuando el enlace de la encargada tiene el cursor o el foco */
  .placa-area:focus-within,
  .placa-area:has(.area-accion:hover) {
    border-color: var(--pl-canto-claro-hundido);
    box-shadow: 0 1px 2px -1px rgb(4 36 74 / 0.3);
    transform: translateY(2px);
  }

  .area-nombre {
    font-family: var(--pl-display);
    font-weight: 600;
    font-size: clamp(20px, 1.9vw, 25px);
    line-height: 1.15;
    letter-spacing: 0.04em;
    margin: 0;
  }

  .area-alcance {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--pl-grafito);
    max-width: 44ch;
  }

  .area-responde {
    margin-top: auto;
    padding-top: 15px;
    border-top: 1px solid rgb(7 55 109 / 0.18);
  }

  .area-responde-et {
    margin: 0 0 4px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--pl-grafito-claro);
  }

  .area-encargada {
    margin: 0 0 8px;
    font-size: 15.5px;
    font-weight: 600;
    color: var(--pl-azul);
  }

  /* Acción primaria: nombrada, no una superficie invisible sobre la placa.
     El destino sigue siendo la encargada; el texto queda seleccionable,
     que es lo que hace esta audiencia con los nombres y los correos. */
  .area-accion {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--pl-azul);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    text-decoration-color: rgb(7 55 109 / 0.5);
  }

  .area-accion:hover { text-decoration-color: var(--pl-azul); }

  .area-correo-dir {
    margin: 5px 0 0;
    font-size: 13.5px;
    color: var(--pl-grafito);
  }

  /* Enlace secundario: va por encima del destino de la placa */
  .area-detalle {
    position: relative;
    z-index: 1;
    align-self: flex-start;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--pl-grafito-claro);
    text-decoration: none;
    border-bottom: 1px solid rgb(79 81 87 / 0.4);
    padding-bottom: 2px;
  }

  .area-detalle:hover {
    color: var(--pl-azul);
    border-bottom-color: var(--pl-azul);
  }

  /* ═══════════════════════════════ Secciones ═══════════════════════════════ */
  .seccion-cabeza {
    max-width: 62ch;
    margin-bottom: clamp(28px, 3.4vw, 46px);
  }

  .seccion-titulo {
    font-family: var(--pl-display);
    font-weight: 500;
    font-size: clamp(25px, 3.1vw, 40px);
    line-height: 1.15;
    letter-spacing: 0.03em;
    color: var(--pl-azul);
    margin: 0;
  }

  .seccion-titulo--claro { color: var(--pl-piedra-alta); }

  .seccion-bajada {
    margin: 14px 0 0;
    font-size: clamp(15px, 1.4vw, 17px);
    line-height: 1.6;
    color: var(--pl-grafito);
    max-width: 62ch;
  }

  .enlace-grabado {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--pl-azul);
    text-decoration: none;
    padding-bottom: 3px;
    border-bottom: 1px solid rgb(7 55 109 / 0.35);
  }

  .enlace-grabado .ico {
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .enlace-grabado:hover { border-bottom-color: var(--pl-azul); }
  .enlace-grabado:hover .ico { transform: translateX(4px); }

  /* ═══════════════ EL PADRÓN: registro rayado, no más placas ═══════════════ */
  .padron {
    padding-block: clamp(48px, 7vw, 96px);
    border-top: 1px solid rgb(7 55 109 / 0.16);
  }

  .registro {
    display: grid;
    gap: clamp(22px, 2.6vw, 34px);
  }

  .registro-grupo {
    display: grid;
    grid-template-columns: minmax(140px, 200px) 1fr;
    gap: clamp(14px, 2.2vw, 30px);
    align-items: start;
  }

  .registro-area {
    font-family: var(--pl-display);
    font-weight: 500;
    font-size: 15px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--pl-azul);
    margin: 0;
    padding-top: 14px;
    border-top: 2px solid var(--pl-azul);
  }

  .registro-lista {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .renglon {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 6px 20px;
    padding: 13px 0;
    border-top: 1px solid rgb(7 55 109 / 0.16);
  }

  .renglon:first-child { border-top-color: rgb(7 55 109 / 0.32); }

  .renglon-nombre {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--pl-azul);
  }

  .renglon-credencial {
    grid-column: 1;
    margin: 0;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--pl-grafito);
    max-width: 60ch;
  }

  .renglon-correo {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--pl-azul);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    text-decoration-color: rgb(7 55 109 / 0.4);
    white-space: nowrap;
  }

  .renglon-correo:hover { text-decoration-color: var(--pl-azul); }
  .renglon-correo .ico { width: 15px; height: 15px; }

  .padron-pie { margin: clamp(28px, 3vw, 40px) 0 0; }

  /* ═════════════════════════════ CONTINUIDAD ═════════════════════════════ */
  .continuidad {
    background-image: linear-gradient(170deg, var(--pl-azul-hondo) 0%, var(--pl-azul-noche) 100%);
    color: var(--pl-piedra-alta);
    padding-block: clamp(48px, 7vw, 92px);
    --foco: var(--pl-azul-claro);
  }

  .hechos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: clamp(20px, 2.4vw, 32px);
    list-style: none;
    margin: clamp(28px, 3.4vw, 46px) 0 0;
    padding: 0;
  }

  .hecho {
    padding-top: 18px;
    border-top: 1px solid rgb(255 255 255 / 0.24);
  }

  .hecho-dato {
    font-family: var(--pl-texto);
    font-weight: 700;
    font-size: 17px;
    letter-spacing: 0.1em;
    color: var(--pl-piedra-alta);
    margin: 0 0 10px;
    font-variant-numeric: tabular-nums;
  }

  .hecho-texto {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.65;
