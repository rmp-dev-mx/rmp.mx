---
import Base from "@layouts/Base.astro";
import Cabecera from "@components/Cabecera.astro";
import { getLang, localizedUrl } from "../../i18n/utils";
import { getIndicadores } from "../../i18n/indicadores";

const lang = getLang(Astro.currentLocale);
const ind = getIndicadores(lang);

const SALIDA =
  '<path d="M14 5h5v5"/><path d="M19 5 10.5 13.5"/><path d="M18 13.5V19H5V6h5.5"/>';
---

<Base title={ind.metaTitle} description={ind.metaDesc} translated={true} fuentes="nuevo">
  <div class="mundo">

    <Cabecera titulo={ind.heroH1} sub={ind.heroSub} />

    <section class="tabla" aria-label={ind.tablaAria}>
      <div class="marco">
        <ul class="lista" role="list">
          {ind.lista.map((i) => (
            <li class="renglon">
              <div class="renglon-cuerpo">
                <h2 class="renglon-nombre">{i.nombre}</h2>
                <p class="renglon-desc">{i.desc}</p>
              </div>
              <a class="renglon-fuente" href={i.url} target="_blank" rel="noopener noreferrer">
                <span>{i.fuente}</span>
                <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" set:html={SALIDA} />
              </a>
            </li>
          ))}
        </ul>

        <p class="nota">
          {ind.notaPre}
          <a href={localizedUrl("/contacto", lang)}>{ind.notaLink}</a>
          {ind.notaPost}
        </p>
      </div>
    </section>

  </div>
</Base>

<style>
  .tabla { padding-block: clamp(44px, 6vw, 88px); }

  .lista {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .renglon {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
    align-items: baseline;
    gap: clamp(12px, 2.4vw, 40px);
    padding: 20px 0;
    border-top: 1px solid var(--rm-linea);
  }

  .renglon:first-child { border-top: 2px solid var(--rm-tinta); }
  .renglon:last-child { border-bottom: 1px solid var(--rm-linea); }

  .renglon-nombre {
    margin: 0 0 4px;
    font-family: var(--rm-serif);
    font-weight: 500;
    font-size: clamp(19px, 1.7vw, 24px);
    line-height: 1.25;
  }

  .renglon-desc {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--rm-tinta-2);
    max-width: 56ch;
  }

  /* La fuente oficial es el destino: el valor vive allá, no aquí */
  .renglon-fuente {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--rm-mono);
    font-size: 12.5px;
    letter-spacing: 0.06em;
    color: var(--rm-azul);
    text-decoration: none;
    justify-self: start;
  }

  .renglon-fuente span {
    border-bottom: 1px solid rgb(7 55 109 / 0.35);
    padding-bottom: 2px;
  }

  .renglon-fuente:hover span { border-bottom-color: var(--rm-azul); }

  .renglon-fuente .ico {
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .renglon-fuente:hover .ico { transform: translate(2px, -2px); }

  .nota {
    margin-top: clamp(26px, 3vw, 38px);
    max-width: 62ch;
    font-size: 15px;
    line-height: 1.6;
    color: var(--rm-tinta-2);
  }

  .nota a {
    color: var(--rm-ambar);
    text-underline-offset: 4px;
  }

  @media (max-width: 760px) {
    .renglon { grid-template-columns: 1fr; gap: 12px; }
  }
</style>
