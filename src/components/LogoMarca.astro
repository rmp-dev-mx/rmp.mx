---
// Emblema oficial de Ramírez Medellín (SVG entregado por el cliente), sin
// letras: el wordmark va en texto. El header del diseño nuevo es siempre
// claro, así que basta la versión a color.
import { url } from "../lib/url";

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span class:list={["logo-marca", className]} aria-hidden="true">
  <img
    src={url("/images/rmp-noLetras.svg")}
    alt=""
    width="50"
    height="38"
    decoding="async"
  />
</span>

<style>
  /* Altura definida aquí (no en el header): Astro no propaga el scope
     del padre al root del hijo, así que .logo-svg del header no alcanza
     este <span>. Solo se usa en el header, donde mide 38px. */
  .logo-marca {
    display: inline-flex;
    line-height: 0;
    height: 38px;
  }
  .logo-marca img {
    display: block;
    height: 100%;
    width: auto;
  }
</style>
